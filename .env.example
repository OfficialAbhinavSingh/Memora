PCE_ADDR=:8080
PCE_API_KEY=change-me
PCE_FAST_WINDOW=30m
PCE_DEEP_WINDOW=4h
PCE_SIMILARITY_LOOKBACK=720h
PCE_READ_TIMEOUT=5s
PCE_WRITE_TIMEOUT=10s
PCE_SHUTDOWN_TIMEOUT=15s
PCE_MAX_REQUEST_BYTES=4194304

KAFKA_BROKERS=kafka:29092
CLICKHOUSE_DSN=http://clickhouse:8123
NEO4J_URI=http://neo4j:7474
POSTGRES_DSN=postgres://pce:pce@postgres:5432/pce?sslmode=disable
REDIS_ADDR=redis:6379
S3_ENDPOINT=http://minio:9000
